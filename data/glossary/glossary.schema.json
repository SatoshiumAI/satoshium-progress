{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satoshiumai.github.io/satoshium-progress/data/glossary/glossary.schema.json",
  "title": "Satoshium Glossary Dataset Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "terms"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "dataset", "version", "last_updated"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string", "const": "glossary" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "last_updated": {
          "type": "string",
          "description": "YYYY-MM-DD",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": { "type": "string" }
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term" }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term", "short", "definition", "category", "tags"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "kebab-case stable identifier"
        },
        "term": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1, "maxLength": 140 },
        "definition": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Grouping bucket used by the Glossary Builder UI"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "see_also": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "description": "Optional: citations / references (URLs or canonical refs).",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
